import os

# Run from the repository root (8cube_isoform/): snakemake finds workflow/Snakefile on its own.
# Inputs are read from workflow/configs, outputs are written to resources/, results/ and logs/.

# Change to wherever the 8cube run is stored (or override with --config run_dir=...)
RUN_DIR = os.path.join(config.get("run_dir", "/home/8cube/raw_data/igvf_010/"), "")
DATA_DIR = RUN_DIR + "nanopore/"

# Each fastq in DATA_DIR is its own sample (sublibraries/runs are never merged)
SAMPLES, = glob_wildcards(DATA_DIR + "{sample,[^/]+}.fastq.gz")

# Illumina R1 (cDNA) reads from every nova* directory, used for short-read splice junctions.
# R2 only holds the UMI/barcodes, so it isn't needed.
NOVA_RUNS, NOVA_LIBS = glob_wildcards(RUN_DIR + "{run,nova[^/]*}/{lib,[^/]+}L001_R1_001.fastq.gz")
SHORT_READS_R1 = sorted(expand(RUN_DIR + "{run}/{lib}L001_R1_001.fastq.gz", zip, run=NOVA_RUNS, lib=NOVA_LIBS))

# Barcodes with fewer UMIs are dropped before transcript quantification, which runs per barcode
# (most barcodes are near-empty). Override with --config min_umis=...
MIN_UMIS = config.get("min_umis", 100)

# Directories
CONFIG_DIR = os.path.join(workflow.basedir, "configs")
RESOURCES_DIR = "resources"
SPLITCODE_DIR = "results/splitcode"
STAR_DIR = "results/star"
FLAIR_DIR = "results/flair"
KALLISTO_DIR = "results/kallisto"
SQANTI3_DIR = "results/sqanti3"

# C57BL/6 T2T genome (T2T_mhaESC_v1.5: chr1-19, X, Y, MT). NCBI has no annotation for it,
# so GENCODE is lifted over from GRCm39.
T2T_ACCESSION = "GCA_056825265.1"
GENOME = f"{RESOURCES_DIR}/genome/t2t.fna"

GENCODE_RELEASE = "M39"
GENCODE_GENOME = f"{RESOURCES_DIR}/gencode/GRCm39.primary_assembly.genome.fa"
GENCODE_GTF = f"{RESOURCES_DIR}/gencode/gencode.v{GENCODE_RELEASE}.primary_assembly.annotation.gtf"

# GTF used by STAR and FLAIR; set to None to run both without an annotation (skips liftoff)
ANNOTATION_GTF = f"{RESOURCES_DIR}/genome/t2t_liftoff.phased.gtf"
LIFTOFF_GTF = f"{RESOURCES_DIR}/genome/t2t_liftoff.gtf"

# General parameters for splitcode filtering
SEQUENCES = ["cDNA", "umi", "barcode"]
DIRECTIONS = ["f", "rc"]

wildcard_constraints:
    sample="[^/]+"

rule all:
    input:
        expand(f"{KALLISTO_DIR}/{{sample}}", sample=SAMPLES)

#---------- Get Genome Reference ----------#

rule reference_download:
    output: GENOME
    params:
        acc=T2T_ACCESSION,
        outdir=f"{RESOURCES_DIR}/genome"
    log:
        "logs/reference_download.out"
    conda: "envs/datasets.yaml"
    shell:
        """
        (datasets download genome accession {params.acc} --include genome --filename {params.outdir}/t2t.zip &&
         unzip -o {params.outdir}/t2t.zip -d {params.outdir}/t2t_unzipped &&
         cp {params.outdir}/t2t_unzipped/ncbi_dataset/data/{params.acc}/*.fna {output} &&
         rm -rf {params.outdir}/t2t.zip {params.outdir}/t2t_unzipped) > {log} 2>&1
        """

rule gencode_download:
    output:
        genome=GENCODE_GENOME,
        gtf=GENCODE_GTF
    params:
        url=f"https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_mouse/release_{GENCODE_RELEASE}",
        release=GENCODE_RELEASE
    log:
        "logs/gencode_download.out"
    shell:
        """
        (curl -sSfL {params.url}/GRCm39.primary_assembly.genome.fa.gz | gunzip -c > {output.genome} &&
         curl -sSfL {params.url}/gencode.v{params.release}.primary_assembly.annotation.gtf.gz | gunzip -c > {output.gtf}) 2> {log}
        """

# GENCODE chromosome name -> T2T GenBank accession (e.g. chr1,CP000001.1), so liftoff
# aligns each chromosome only to its counterpart
rule t2t_chrom_map:
    output: f"{RESOURCES_DIR}/genome/chroms.csv"
    params:
        acc=T2T_ACCESSION
    log:
        "logs/t2t_chrom_map.out"
    conda: "envs/datasets.yaml"
    shell:
        """
        (datasets summary genome accession {params.acc} --report sequence --as-json-lines \
            | dataformat tsv genome-seq --fields chr-name,genbank-seq-acc,role \
            | awk -F'\\t' 'NR > 1 && $3 == "assembled-molecule" {{ print ($1 == "MT" ? "chrM" : "chr" $1) "," $2 }}' \
            > {output}) 2> {log}
        """

rule liftoff:
    input:
        target_genome=GENOME,
        ref_genome=GENCODE_GENOME,
        gtf=GENCODE_GTF,
        chroms=f"{RESOURCES_DIR}/genome/chroms.csv"
    output:
        gtf=LIFTOFF_GTF,
        unmapped=f"{RESOURCES_DIR}/genome/t2t_liftoff_unmapped.txt"
    params:
        tmpdir=f"{RESOURCES_DIR}/liftoff_intermediate"
    threads: 32
    resources:
        mem_mb=60000
    log:
        "logs/liftoff.out"
    conda: "envs/liftoff.yaml"
    shell:
        """
        (liftoff -g {input.gtf} -chroms {input.chroms} -o {output.gtf} -u {output.unmapped} \
            -dir {params.tmpdir} -p {threads} {input.target_genome} {input.ref_genome} &&
         rm -rf {params.tmpdir}) > {log} 2>&1
        """

# Liftoff writes "." as the phase of every feature; recompute CDS/start/stop codon phases
# (gtfToGenePred -genePredExt, used by SQANTI3, rejects coding features without one)
rule fix_cds_phases:
    input:
        source_gtf=GENCODE_GTF,
        lifted_gtf=LIFTOFF_GTF
    output: ANNOTATION_GTF
    resources:
        mem_mb=4000
    log:
        "logs/fix_cds_phases.out"
    script:
        "scripts/fix_cds_phases.py"

#---------- Process Nanopore Data ----------#

rule generate_config:
    input:
        ont_seqspec=f"{CONFIG_DIR}/nanopore-seqspec.yaml"
    output:
        ont_config=f"{SPLITCODE_DIR}/ONT.config"
    log:
        "logs/generate_config.out"
    conda: "envs/seqspec.yaml"
    shell:
        """
        # Keep only the forward (f) and reverse-complement (rc) orientations. Then flip the cDNA
        # extracts: as written, cDNA is read from the RT primer onward (first-strand cDNA, antisense
        # to the mRNA), which puts FLAIR's single-exon isoforms on the wrong strand.
        (seqspec index -m rna -s read -i nanopore_read -t splitcode {input.ont_seqspec} > {output.ont_config} &&
         sed -i -E '/<~c_|<r_/d; /\tlinker-[0-9]+[cr]\t/d; s/<f_cDNA>/<~f_cDNA>/; s/<~rc_cDNA>/<rc_cDNA>/' {output.ont_config}) 2> {log}
        """

def get_fastq_path(wildcards):
    return DATA_DIR + f"{wildcards.sample}.fastq.gz"

rule splitcode_filter:
    input:
        ont_config=f"{SPLITCODE_DIR}/ONT.config",
        fastq=get_fastq_path
    output:
        temp(expand(SPLITCODE_DIR + "/{{sample}}/{direction}_{sequence}.fastq.gz",
            direction=DIRECTIONS, sequence=SEQUENCES))
    params:
        outdir=SPLITCODE_DIR + "/{sample}"
    log:
        "logs/splitcode_filter_{sample}.out"
    threads: 16
    resources:
        mem_mb=16000
    conda: "envs/splitcode.yaml"
    shell:
        """
        config=$(realpath {input.ont_config})
        fastq=$(realpath {input.fastq})
        (cd {params.outdir} && splitcode --x-only --gzip --no-outb -c "$config" -t {threads} "$fastq") > {log} 2>&1
        """

rule reorient_barcodes:
    input: f"{SPLITCODE_DIR}/{{sample}}/rc_barcode.fastq.gz"
    output: temp(f"{SPLITCODE_DIR}/{{sample}}/rc_barcode_reoriented.fastq.gz")
    threads: 16
    log: "logs/reorient_barcodes_{sample}.out"
    conda: "envs/pigz.yaml"
    shell:
        """
        (pigz -dc {input} \
            | awk 'NR % 2 == 0 {{ $0 = substr($0, 17, 8) substr($0, 9, 8) substr($0, 1, 8) }} {{ print }}' \
            | pigz -p {threads} > {output}) 2> {log}
        """

def get_rc_input(wildcards):
    suffix = "_reoriented" if wildcards.sequence == "barcode" else ""
    return f"{SPLITCODE_DIR}/{wildcards.sample}/rc_{wildcards.sequence}{suffix}.fastq.gz"

rule concatenate_fastq:
    input:
        f=f"{SPLITCODE_DIR}/{{sample}}/f_{{sequence}}.fastq.gz",
        rc=get_rc_input,
    output: temp(f"{SPLITCODE_DIR}/{{sample}}/{{sequence}}.fastq.gz")
    wildcard_constraints:
        sequence="|".join(SEQUENCES)
    log: "logs/concatenate_fastq_{sample}_{sequence}.out"
    shell:
        "cat {input.f} {input.rc} > {output} 2> {log}"

rule correct_barcodes:
    input:
        config = f"{CONFIG_DIR}/config-correct.txt",
        onlists = expand(f"{CONFIG_DIR}/onlists/{{f}}", f=["r1_R.txt", "r1_T.txt", "r2_3.txt"]),
        barcode_fastq = f"{SPLITCODE_DIR}/{{sample}}/barcode.fastq.gz",
        cdna_fastq = f"{SPLITCODE_DIR}/{{sample}}/cDNA.fastq.gz",
        umi_fastq = f"{SPLITCODE_DIR}/{{sample}}/umi.fastq.gz"
    output:
        barcode_fastq = temp(f"{SPLITCODE_DIR}/{{sample}}/barcode_corrected.fastq.gz"),
        cdna_fastq = f"{SPLITCODE_DIR}/{{sample}}/cDNA_corrected.fastq.gz",
        umi_fastq = f"{SPLITCODE_DIR}/{{sample}}/umi_corrected.fastq.gz",
        # uncorrected barcodes of the kept reads (unused; splitcode needs one output per input file)
        filtered_fastq = temp(f"{SPLITCODE_DIR}/{{sample}}/barcode_filtered.fastq.gz")
    params:
        outdir = f"{SPLITCODE_DIR}/{{sample}}",
        onlist_dir = f"{CONFIG_DIR}/onlists"
    threads: 16
    resources:
        mem_mb=8000
    log: "logs/correct_barcodes_{sample}.out"
    conda: "envs/splitcode.yaml"
    shell:
        r"""
        # config-correct.txt names the onlists without a directory; give splitcode a copy with full paths
        config=$(mktemp)
        trap 'rm -f "$config"' EXIT
        sed -E "s#^([^[:space:]]+\.txt[$])#{params.onlist_dir}/\1#" {input.config} > "$config"

        cdna_fastq=$(realpath {input.cdna_fastq})
        umi_fastq=$(realpath {input.umi_fastq})
        barcode_fastq=$(realpath {input.barcode_fastq})
        (cd {params.outdir} && \
         splitcode -c "$config" --nFastqs=3 -t {threads} --gzip \
            -o cDNA_corrected.fastq.gz,umi_corrected.fastq.gz,barcode_filtered.fastq.gz \
            "$cdna_fastq" "$umi_fastq" "$barcode_fastq") > {log} 2>&1
        """

rule extract_polyT:
    input:
        config = f"{CONFIG_DIR}/config-RT-polyT.txt",
        onlist = f"{CONFIG_DIR}/onlists/r1_T.txt",
        barcode_fastq = f"{SPLITCODE_DIR}/{{sample}}/barcode_corrected.fastq.gz",
        cdna_fastq = f"{SPLITCODE_DIR}/{{sample}}/cDNA_corrected.fastq.gz",
        umi_fastq = f"{SPLITCODE_DIR}/{{sample}}/umi_corrected.fastq.gz"
    output:
        barcode_fastq = f"{SPLITCODE_DIR}/{{sample}}/barcode_polyT.fastq.gz",
        cdna_fastq = f"{SPLITCODE_DIR}/{{sample}}/cDNA_polyT.fastq.gz",
        umi_fastq = f"{SPLITCODE_DIR}/{{sample}}/umi_polyT.fastq.gz"
    threads: 16
    resources:
        mem_mb=4000
    params:
        onlist_dir = f"{CONFIG_DIR}/onlists"
    log: "logs/extract_polyT_{sample}.out"
    conda: "envs/splitcode.yaml"
    shell:
        r"""
        # config-RT-polyT.txt names the onlist without a directory; give splitcode a copy with the full path
        config=$(mktemp)
        keep=$(mktemp)
        trap 'rm -f "$config" "$keep"' EXIT
        sed -E "s#^([^[:space:]]+\.txt[$])#{params.onlist_dir}/\1#" {input.config} > "$config"
        echo polyT > "$keep"

        splitcode -c "$config" --keep-grp "$keep" --nFastqs=3 -t {threads} --gzip \
            -o {output.cdna_fastq},{output.umi_fastq},{output.barcode_fastq} \
            {input.cdna_fastq} {input.umi_fastq} {input.barcode_fastq} > {log} 2>&1
        """

rule merge_tags:
    input:
        config = f"{CONFIG_DIR}/config-mergeRT.txt",
        barcode_fastq = f"{SPLITCODE_DIR}/{{sample}}/barcode_corrected.fastq.gz"
    output: f"{SPLITCODE_DIR}/{{sample}}/barcode_merged.fastq.gz"
    threads: 16
    resources:
        mem_mb=4000
    log: "logs/merge_tags_{sample}.out"
    conda: "envs/splitcode.yaml"
    shell:
        """
        splitcode -c {input.config} -t {threads} --gzip -o {output} {input.barcode_fastq} > {log} 2>&1
        """

#---------- Short-read Splice Junctions ----------#

rule star_index:
    input:
        genome=GENOME,
        gtf=[ANNOTATION_GTF] if ANNOTATION_GTF else []
    output:
        directory(f"{RESOURCES_DIR}/star_index")
    params:
        # overhang = R1 length (140 bp) - 1
        sjdb=f"--sjdbGTFfile {ANNOTATION_GTF} --sjdbOverhang 139" if ANNOTATION_GTF else ""
    threads: 16
    resources:
        mem_mb=40000
    log:
        "logs/star_index.out"
    conda: "envs/star.yaml"
    shell:
        """
        mkdir -p {output}
        STAR --runMode genomeGenerate --runThreadN {threads} --genomeDir {output} \
            --genomeFastaFiles {input.genome} {params.sjdb} \
            --outFileNamePrefix {output}/ > {log} 2>&1
        """

rule star_junctions:
    input:
        index=f"{RESOURCES_DIR}/star_index",
        reads=SHORT_READS_R1
    output:
        f"{STAR_DIR}/SJ.out.tab"
    params:
        prefix=f"{STAR_DIR}/",
        reads=",".join(SHORT_READS_R1)
    threads: 16
    resources:
        mem_mb=40000
    log:
        "logs/star_junctions.out"
    conda: "envs/star.yaml"
    shell:
        """
        STAR --runThreadN {threads} --genomeDir {input.index} \
            --readFilesIn {params.reads} --readFilesCommand zcat \
            --outSAMtype None --outFileNamePrefix {params.prefix} > {log} 2>&1
        """

#---------- Build Transcriptome ----------#

rule genome_align:
    input:
        genome=GENOME,
        reads=expand(f"{SPLITCODE_DIR}/{{sample}}/cDNA_polyT.fastq.gz", sample=SAMPLES)
    output:
        bam=f"{FLAIR_DIR}/flair.aligned.bam",
        bai=f"{FLAIR_DIR}/flair.aligned.bam.bai",
        bed=temp(f"{FLAIR_DIR}/flair.aligned.bed")
    params:
        prefix=f"{FLAIR_DIR}/flair.aligned"
    threads: 32
    resources:
        mem_mb=32000
    log:
        "logs/genome_align.out"
    conda: "envs/flair.yaml"
    shell:
        "flair align -g {input.genome} -r {input.reads} -o {params.prefix} -t {threads} > {log} 2>&1"

rule build_transcriptome:
    input:
        bam=f"{FLAIR_DIR}/flair.aligned.bam",
        bai=f"{FLAIR_DIR}/flair.aligned.bam.bai",
        genome=GENOME,
        junctions=f"{STAR_DIR}/SJ.out.tab",
        gtf=[ANNOTATION_GTF] if ANNOTATION_GTF else []
    output:
        gtf=f"{FLAIR_DIR}/flair.isoforms.gtf",
        bed=f"{FLAIR_DIR}/flair.isoforms.bed",
        fasta=f"{FLAIR_DIR}/flair.isoforms.fa",
        read_map=f"{FLAIR_DIR}/flair.isoform.read.map.txt",
        counts=f"{FLAIR_DIR}/flair.isoform.counts.txt"
    params:
        prefix=f"{FLAIR_DIR}/flair",
        annotation=f"-f {ANNOTATION_GTF}" if ANNOTATION_GTF else ""
    threads: 32
    resources:
        mem_mb=32000
    log:
        "logs/build_transcriptome.out"
    conda: "envs/flair.yaml"
    shell:
        """
        flair transcriptome -b {input.bam} -g {input.genome} --junction_tab {input.junctions} \
            {params.annotation} -o {params.prefix} -t {threads} > {log} 2>&1
        """

rule unique_isoform_ids:
    # FLAIR's GTF can reuse a read-named transcript_id in different genes, but SQANTI3 and kb ref
    # need unique IDs. Rename every transcript to FLAIR's own unique "{transcript}_{gene}" name,
    # as used in flair.isoforms.{bed,fa} and the FLAIR counts.
    input: f"{FLAIR_DIR}/flair.isoforms.gtf"
    output: f"{FLAIR_DIR}/flair.isoforms.unique_ids.gtf"
    shell:
        r"""
        awk 'BEGIN {{ FS = OFS = "\t" }}
             match($9, /gene_id "[^"]+"/) {{
                 gene = substr($9, RSTART + 9, RLENGTH - 10)
                 if (match($9, /transcript_id "[^"]+"/))
                     $9 = substr($9, 1, RSTART + RLENGTH - 2) "_" gene substr($9, RSTART + RLENGTH - 1)
             }}
             {{ print }}' {input} > {output}
        """

#---------- Transcriptome QC and Filtering ----------#
rule sqanti3:
    input:
        flair_gtf=f"{FLAIR_DIR}/flair.isoforms.unique_ids.gtf",
        ref_gtf=ANNOTATION_GTF,
        genome=GENOME,
        junctions=f"{STAR_DIR}/SJ.out.tab"
    output:
        classification=f"{SQANTI3_DIR}/flair_classification.txt",
        junctions=f"{SQANTI3_DIR}/flair_junctions.txt",
        corrected_gtf=f"{SQANTI3_DIR}/flair_corrected.gtf",
        corrected_fasta=f"{SQANTI3_DIR}/flair_corrected.fasta",
        filter_classification=f"{SQANTI3_DIR}/flair_RulesFilter_classification.txt",
        filtered_gtf=f"{SQANTI3_DIR}/flair.filtered.gtf"
    params:
        dir=SQANTI3_DIR,
        prefix="flair",
        chunks=8
    threads: 32
    resources:
        mem_mb=64000
    log:
        "logs/sqanti3.out"
    conda: "envs/sqanti3.yaml"
    shell:
        """
        # SQANTI3 reuses files it finds in its chunk folders, including incomplete ones from an
        # interrupted run, so start from a clean folder
        rm -rf {params.dir}/{params.prefix}_splits
        config=$(mktemp --suffix .yaml)
        trap 'rm -f "$config"' EXIT
        (sqanti3 init -c "$config" -a \
            isoforms={input.flair_gtf} refGTF={input.ref_gtf} refFasta={input.genome} \
            coverage={input.junctions} dir={params.dir} output={params.prefix} \
            cpus=$(( {threads} / {params.chunks} )) chunks={params.chunks}
         sqanti3 qc -c "$config"
         sqanti3 filter -c "$config") > {log} 2>&1
        """

rule sqanti3_reference_qc:
    # SQANTI3 QC of the reference annotation itself (refClassif), needed by full-mode rescue to
    # judge which reference transcripts can replace discarded artifacts. Depends only on the
    # reference, so it lives in resources/. Each transcript is a full-splice match of itself.
    input:
        ref_gtf=ANNOTATION_GTF,
        genome=GENOME
    output:
        f"{RESOURCES_DIR}/sqanti3_reference/reference_classification.txt"
    params:
        dir=f"{RESOURCES_DIR}/sqanti3_reference",
        prefix="reference",
        chunks=8
    threads: 32
    resources:
        mem_mb=64000
    log:
        "logs/sqanti3_reference_qc.out"
    conda: "envs/sqanti3.yaml"
    shell:
        """
        # SQANTI3 reuses files it finds in its chunk folders, including incomplete ones from an
        # interrupted run, so start from a clean folder
        rm -rf {params.dir}/{params.prefix}_splits
        config=$(mktemp --suffix .yaml)
        trap 'rm -f "$config"' EXIT
        (sqanti3 init -c "$config" -a \
            isoforms={input.ref_gtf} refGTF={input.ref_gtf} refFasta={input.genome} \
            dir={params.dir} output={params.prefix} report=skip \
            cpus=$(( {threads} / {params.chunks} )) chunks={params.chunks}
         sqanti3 qc -c "$config") > {log} 2>&1
        """

rule sqanti3_rescue:
    # Full-mode rescue: automatic rescue of full-splice-match artifacts, plus mapping of the other
    # artifacts (ISM, NIC, NNC) to reference and kept isoforms; reference transcripts that pass the
    # same rules are added back, so genes whose isoforms were all filtered keep a quantification
    # target. Requantification is skipped: it redistributes SQANTI3's own counts, and we use kallisto.
    input:
        filter_classification=f"{SQANTI3_DIR}/flair_RulesFilter_classification.txt",
        filtered_gtf=f"{SQANTI3_DIR}/flair.filtered.gtf",
        corrected_fasta=f"{SQANTI3_DIR}/flair_corrected.fasta",
        ref_classification=f"{RESOURCES_DIR}/sqanti3_reference/reference_classification.txt",
        ref_gtf=ANNOTATION_GTF,
        genome=GENOME
    output:
        gtf=f"{SQANTI3_DIR}/flair_rescued.gtf"
    params:
        dir=SQANTI3_DIR,
        prefix="flair"
    threads: 32
    resources:
        mem_mb=32000
    log:
        "logs/sqanti3_rescue.out"
    conda: "envs/sqanti3.yaml"
    shell:
        """
        config=$(mktemp --suffix .yaml)
        trap 'rm -f "$config"' EXIT
        (sqanti3 init -c "$config" -a \
            refGTF={input.ref_gtf} refFasta={input.genome} dir={params.dir} output={params.prefix} \
            filter_class={input.filter_classification} filtered_isoforms_gtf={input.filtered_gtf} \
            corrected_isoforms_fasta={input.corrected_fasta} refClassif={input.ref_classification} \
            mode=full skip_requant=true cpus={threads}
         sqanti3 rescue -c "$config") > {log} 2>&1
        """

#---------- lr-kallisto Quantification ----------#
rule kallisto_index:
    input:
        genome=GENOME,
        gtf=f"{SQANTI3_DIR}/flair_rescued.gtf"
    output:
        index=f"{KALLISTO_DIR}/index.idx",
        t2g=f"{KALLISTO_DIR}/t2g.txt",
        fasta=temp(f"{KALLISTO_DIR}/fasta.fa")
    threads: 32
    resources:
        mem_mb=32000
    log:
        "logs/kallisto_index.out"
    conda: "envs/kb_python.yaml"
    shell:
        """
        kb ref -k 63 -i {output.index} -g {output.t2g} -f1 {output.fasta} -t {threads} \
            {input.genome} {input.gtf} > {log} 2>&1
        """

rule kallisto_count:
    input:
        index=f"{KALLISTO_DIR}/index.idx",
        t2g=f"{KALLISTO_DIR}/t2g.txt",
        barcode_fastq = f"{SPLITCODE_DIR}/{{sample}}/barcode_merged.fastq.gz",
        cdna_fastq = f"{SPLITCODE_DIR}/{{sample}}/cDNA_corrected.fastq.gz",
        umi_fastq = f"{SPLITCODE_DIR}/{{sample}}/umi_corrected.fastq.gz"
    output:
        dir=directory(f"{KALLISTO_DIR}/{{sample}}")
    params:
        min_umis=MIN_UMIS,
        filter_script=f"{workflow.basedir}/scripts/filter_barcodes.py"
    threads: 16
    resources:
        mem_mb=16000
    log:
        "logs/kallisto_count_{sample}.out"
    conda: "envs/kb_python.yaml"
    shell:
        """
        kb count -k 63 --long --platform ONT --threshold 0.8 -x '2,0,24:1,0,10:0,0,0' \
            -w NONE --tcc \
            -i {input.index} -g {input.t2g} -o {output.dir} --h5ad -t {threads} \
            {input.cdna_fastq} {input.umi_fastq} {input.barcode_fastq} \
            > {log} 2>&1

        # Drop near-empty barcodes: quant-tcc runs per barcode, and most of the barcodes in
        # counts_unfiltered/ have only a few UMIs
        unfiltered={output.dir}/counts_unfiltered/cells_x_tcc
        filtered={output.dir}/counts_filtered/cells_x_tcc
        mkdir -p {output.dir}/counts_filtered
        python {params.filter_script} {params.min_umis} "$unfiltered.mtx" "$unfiltered.barcodes.txt" \
            "$filtered.mtx" "$filtered.barcodes.txt" >> {log} 2>&1
        cp "$unfiltered.ec.txt" "$filtered.ec.txt"

        # kb only runs quant-tcc for bulk/Smart-seq, so run it here: resolves the cell x TCC matrix
        # into cell x transcript abundances (quant/matrix.abundance.mtx; rows = counts_filtered barcodes).
        # kallisto ships inside kb_python; k64 is the build that matches the k=63 index.
        kallisto=$(python -c 'import kb_python, os; print(os.path.join(os.path.dirname(kb_python.__file__), "bins/linux/kallisto/kallisto_k64"))')
        "$kallisto" quant-tcc --long -P ONT -t {threads} \
            -i {output.dir}/index.saved -e "$filtered.ec.txt" \
            -f {output.dir}/flens.txt -g {input.t2g} -o {output.dir}/quant \
            "$filtered.mtx" >> {log} 2>&1
        """